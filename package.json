{
  "name": "my-projects-rest-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply projects_db --local",
    "db:migrate:remote": " wrangler d1 migrations apply projects_db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^4.0.0",
    "eslint-config-prettier": "^6.15.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
